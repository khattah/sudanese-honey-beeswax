  color: white;
  font-weight: 700;
  padding: 15px;
  text-align: center;
}
.features {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
  padding: 35px 8%;
  background: white;
  text-align: center;
}
.features > div { font-size: 26px; }
.features strong {
  display: block;
  margin-top: 10px;
  font-size: 16px;
}
.features p { font-size: 13px; color: #7c7368; }
.section {
  max-width: 1250px;
  margin: auto;
  padding: 75px 25px;
}
.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  margin-bottom: 30px;
}
.section h1, .section h2 { color: #3f2d16; }
.section h1 { font-size: 42px; }
.section h2 { font-size: 35px; margin: 12px 0; }
.text-button {
  background: transparent;
  border: none;
  color: #9b650d;
  font-weight: 700;
}
.product-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 22px;
}
.product-card {
  border: 1px solid #eee6da;
  background: white;
  border-radius: 15px;
  overflow: hidden;
  box-shadow: 0 8px 25px #3c2d130a;
}
.product-image { height: 210px; background: #f8efdb; }
.product-image img { width: 100%; height: 100%; object-fit: cover; }
.product-info { padding: 20px; }
.category {
  color: #ae7b28;
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
}
.product-info h3 { font-size: 17px; margin: 10px 0; }
.product-info p { color: #84796b; font-size: 14px; }
.product-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
  margin-top: 20px;
}
.product-bottom button {
  border: none;
  border-radius: 7px;
  padding: 9px 13px;
  background: #f6e5c1;
  color: #67430e;
  font-weight: 800;
}
.story-banner {
  text-align: center;
  padding: 80px 25px;
  background: #f6ebd3;
}
.story-banner h2 { font-size: 38px; }
.story-banner p {
  max-width: 600px;
  margin: 15px auto 30px;
  line-height: 1.8;
}
.community-banner {
  text-align: center;
  padding: 70px 25px;
  background: #fff9eb;
}
.community-banner h2 { font-size: 34px; }
.community-banner p {
  max-width: 600px;
  margin: 15px auto 25px;
  line-height: 1.8;
}
.whatsapp-button {
  background: #208c52;
  color: white;
  border: none;
  border-radius: 8px;
  padding: 15px 24px;
  font-weight: 700;
}
.whatsapp-button:hover { background: #17683d; }
.page-section { min-height: 65vh; }
.intro { color: #766b5c; margin-bottom: 30px; }
.narrow { max-width: 800px; }
.narrow p { line-height: 1.8; }
.cart-item {
  display: flex;
