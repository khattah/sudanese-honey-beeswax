  border: none;
  border-radius: 8px;
  padding: 15px 24px;
  font-weight: 700;
}
.primary:hover { background: #68400c; }
.secondary {
  background: transparent;
  border: 1px solid #8c5711;
  color: #69420c;
  border-radius: 8px;
  padding: 14px 23px;
  font-weight: 700;
}
.hero-visual {
