
<script setup>
import { computed, ref, watch } from 'vue'
import { useI18n } from 'vue-i18n'

const { t, locale } = useI18n()

const page = ref('home')
const cart = ref([])
const website = 'honey.khattah.com'
const whatsappLink = 'https://chat.whatsapp.com/IX9KZFfMfCsF0y06jO7Egu'

const customer = ref({
  name: '',
  email: '',
  address: '',
  city: '',
  postalCode: ''
})

const contact = ref({
  name: '',
  email: '',
  subject: 'productInquiry',
  message: ''
})

const contactNotice = ref(false)

const products = [
  {
    id: 1,
    nameKey: 'products.honey',
    categoryKey: 'products.honeyCategory',
    size: '500 g',
    price: 24.99,
    image: 'https://images.unsplash.com/photo-1587049352851-8d4e89133924?w=800'
  },
  {
    id: 2,
    nameKey: 'products.honeycomb',
    categoryKey: 'products.honeyCategory',
    size: '250 g',
    price: 19.99,
    image: 'https://images.unsplash.com/photo-1474979266404-7eaacbcd87c5?w=800'
  },
  {
    id: 3,
    nameKey: 'products.beeswaxBlocks',
    categoryKey: 'products.beeswaxCategory',
    size: '500 g',
    price: 17.99,
    image: 'https://images.unsplash.com/photo-1603006905003-be475563bc59?w=800'
  },
  {
    id: 4,
    nameKey: 'products.beeswaxPellets',
    categoryKey: 'products.beeswaxCategory',
    size: '250 g',
    price: 12.99,
    image: 'https://images.unsplash.com/photo-1602874801007-bd458bb1b8b6?w=800'
  }
]

const cartCount = computed(() =>
  cart.value.reduce((total, item) => total + item.quantity, 0)
)

const subtotal = computed(() =>
  cart.value.reduce(
    (total, item) => total + item.price * item.quantity,
    0
  )
)

const money = value =>
  new Intl.NumberFormat(locale.value === 'ar' ? 'ar-EG' : 'en-CA', {
    style: 'currency',
    currency: 'CAD'
  }).format(value)

function setLanguage(language) {
  locale.value = language
}

watch(locale, language => {
  document.documentElement.lang = language
  document.documentElement.dir = language === 'ar' ? 'rtl' : 'ltr'
  localStorage.setItem('honey-language', language)
}, { immediate: true })

function navigate(destination) {
  page.value = destination
  window.scrollTo(0, 0)
}

function addToCart(product) {
  const existing = cart.value.find(item => item.id === product.id)
  if (existing) {
    existing.quantity++
  } else {
    cart.value.push({ ...product, quantity: 1 })
  }
}

function removeFromCart(id) {
  cart.value = cart.value.filter(item => item.id !== id)
}

function decreaseQuantity(item) {
  if (item.quantity > 1) {
    item.quantity--
  } else {
    removeFromCart(item.id)
  }
}

function proceedToPayment() {
  if (!cart.value.length) {
    navigate('shop')
    return
  }

  if (
    !customer.value.name.trim() ||
    !customer.value.email.trim() ||
    !customer.value.address.trim() ||
    !customer.value.city.trim() ||
    !customer.value.postalCode.trim()
  ) {
    alert(t('checkout.required'))
    return
  }

  navigate('payment')
}

function submitContact() {
  contactNotice.value = true
}

function openWhatsApp() {
  window.open(whatsappLink, '_blank', 'noopener,noreferrer')
}
</script>

<template>
  <div class="website" :dir="locale === 'ar' ? 'rtl' : 'ltr'">
    <header class="header">
      
<div class="logo" @click="navigate('home')">
  <span class="logo-icon">🍯</span>

  <div class="logo-text">
    <template v-if="locale === 'en'">
      <span class="brand-top">AUTHENTIC SUDANESE</span>
      <strong class="brand-main">HONEY & BEESWAX</strong>
      <span class="brand-by">By KHATTAH</span>
    </template>

    <template v-else>
      <span class="brand-top">منتجات النحل السودانية الأصيلة</span>
      <strong class="brand-main">العسل وشمع النحل</strong>
      <span class="brand-by">بواسطة ختّه</span>
    </template>

    <span class="website-label">honey.khattah.com</span>
  </div>
</div>

        <span class="logo-icon">🍯</span>
        <div>
          <strong>{{ t('brand.name') }}</strong>
          <small>{{ t('brand.by') }}</small>
          <span class="website-label">{{ website }}</span>
        </div>
      </div>

      <nav>
        <button @click="navigate('home')">{{ t('nav.home') }}</button>
        <button @click="navigate('shop')">{{ t('nav.shop') }}</button>
        <button @click="navigate('about')">{{ t('nav.about') }}</button>
        <button @click="navigate('wholesale')">{{ t('nav.wholesale') }}</button>
        <button @click="navigate('contact')">{{ t('nav.contact') }}</button>
        <button @click="navigate('whatsapp')">{{ t('nav.whatsapp') }}</button>
        <button class="cart-button" @click="navigate('cart')">
          🛒 {{ t('nav.cart') }} ({{ cartCount }})
        </button>
      </nav>

      <div class="language-switch">
        <button
          :class="{ active: locale === 'en' }"
          @click="setLanguage('en')"
        >EN</button>
        <button
          :class="{ active: locale === 'ar' }"
          @click="setLanguage('ar')"
        >العربية</button>
      </div>
    </header>

    <main>
      <!-- HOME -->
      <template v-if="page === 'home'">
        <section class="hero">
          <div class="hero-content">
            <span class="eyebrow">{{ t('home.eyebrow') }}</span>
            <h1>{{ t('home.title') }}</h1>
            <p>{{ t('home.description') }}</p>

            <div class="hero-actions">
              <button class="primary" @click="navigate('shop')">
                {{ t('home.explore') }}
              </button>
              <button class="secondary" @click="navigate('about')">
                {{ t('home.story') }}
              </button>
            </div>
            <p class="website-address">{{ website }}</p>
          </div>

          <div class="hero-visual">
            <span>🍯</span>
            <div class="hero-label">{{ t('home.heritage') }}</div>
          </div>
        </section>

        <section class="features">
          <div>
            🌿
            <strong>{{ t('home.heritage') }}</strong>
            <p>{{ t('home.heritageDescription') }}</p>
          </div>
          <div>
            🐝
            <strong>{{ t('home.beeProducts') }}</strong>
            <p>{{ t('home.beeDescription') }}</p>
          </div>
          <div>
            📦
            <strong>{{ t('home.retail') }}</strong>
            <p>{{ t('home.retailDescription') }}</p>
          </div>
        </section>

        <section class="section">
          <div class="section-heading">
            <div>
              <span class="eyebrow">{{ t('home.collection') }}</span>
              <h2>{{ t('home.products') }}</h2>
            </div>
            <button class="text-button" @click="navigate('shop')">
              {{ t('home.viewAll') }}
            </button>
          </div>

          <div class="product-grid">
            <article
              v-for="product in products"
              :key="product.id"
              class="product-card"
            >
              <div class="product-image">
                <img :src="product.image" :alt="t(product.nameKey)">
              </div>
              <div class="product-info">
                <span class="category">{{ t(product.categoryKey) }}</span>
                <h3>{{ t(product.nameKey) }}</h3>
                <p>{{ product.size }}</p>
                <div class="product-bottom">
                  <strong>{{ money(product.price) }}</strong>
                  <button @click="addToCart(product)">
                    {{ t('shop.add') }} +
                  </button>
                </div>
              </div>
            </article>
          </div>
        </section>

        <section class="story-banner">
          <h2>{{ t('home.storyTitle') }}</h2>
          <p>{{ t('home.storyDescription') }}</p>
          <button class="primary" @click="navigate('about')">
            {{ t('home.story') }}
          </button>
        </section>

        <section class="community-banner">
          <h2>{{ t('home.community') }}</h2>
          <p>{{ t('home.communityDescription') }}</p>
          <button class="whatsapp-button" @click="openWhatsApp">
            {{ t('whatsapp.join') }}
          </button>
        </section>
      </template>

      <!-- SHOP -->
      <section v-else-if="page === 'shop'" class="section page-section">
        <h1>{{ t('shop.title') }}</h1>
        <p class="intro">{{ t('shop.description') }}</p>

        <div class="product-grid">
          <article
            v-for="product in products"
            :key="product.id"
            class="product-card"
          >
            <div class="product-image">
              <img :src="product.image" :alt="t(product.nameKey)">
            </div>
            <div class="product-info">
              <span class="category">{{ t(product.categoryKey) }}</span>
              <h3>{{ t(product.nameKey) }}</h3>
              <p>{{ product.size }}</p>
              <div class="product-bottom">
                <strong>{{ money(product.price) }}</strong>
                <button @click="addToCart(product)">
                  {{ t('shop.add') }} +
                </button>
              </div>
            </div>
          </article>
        </div>
      </section>

      <!-- CART -->
      <section v-else-if="page === 'cart'" class="section page-section">
        <h1>{{ t('cart.title') }}</h1>

        <template v-if="cart.length === 0">
          <p>{{ t('cart.empty') }}</p>
          <button class="primary" @click="navigate('shop')">
            {{ t('cart.continue') }}
          </button>
        </template>

        <template v-else>
          <div v-for="item in cart" :key="item.id" class="cart-item">
            <div>
              <strong>{{ t(item.nameKey) }}</strong>
              <p>{{ item.size }} · {{ money(item.price) }}</p>
            </div>
            <div class="quantity">
              <button @click="decreaseQuantity(item)">−</button>
              <span>{{ item.quantity }}</span>
              <button @click="item.quantity++">+</button>
            </div>
            <button class="remove" @click="removeFromCart(item.id)">
              {{ t('cart.remove') }}
            </button>
          </div>

          <div class="total">
            <strong>{{ t('cart.subtotal') }}</strong>
            <strong>{{ money(subtotal) }}</strong>
          </div>
          <p class="note">{{ t('cart.note') }}</p>
          <button class="primary" @click="navigate('checkout')">
            {{ t('cart.checkout') }}
          </button>
        </template>
      </section>

      <!-- CHECKOUT -->
      <section
        v-else-if="page === 'checkout'"
        class="section page-section narrow"
      >
        <h1>{{ t('checkout.title') }}</h1>
        <p>{{ t('checkout.description') }}</p>

        <form
          v-if="cart.length"
          class="checkout-form"
          @submit.prevent="proceedToPayment"
        >
          <label>
            {{ t('checkout.name') }}
            <input v-model="customer.name" required>
          </label>
          <label>
            {{ t('checkout.email') }}
            <input v-model="customer.email" type="email" required>
          </label>
          <label>
            {{ t('checkout.address') }}
            <input v-model="customer.address" required>
          </label>
          <label>
            {{ t('checkout.city') }}
            <input v-model="customer.city" required>
          </label>
          <label>
            {{ t('checkout.postalCode') }}
            <input v-model="customer.postalCode" required>
          </label>
          <div class="total">
            <strong>{{ t('cart.subtotal') }}</strong>
            <strong>{{ money(subtotal) }}</strong>
          </div>
          <button class="primary" type="submit">
            {{ t('checkout.payment') }}
          </button>
        </form>

        <button v-else class="primary" @click="navigate('shop')">
          {{ t('checkout.returnShop') }}
        </button>
      </section>

      <!-- PAYMENT -->
      <section
        v-else-if="page === 'payment'"
        class="section page-section narrow"
      >
        <h1>{{ t('payment.title') }}</h1>
        <div class="payment-box">
          <span class="payment-icon">🔒</span>
          <h2>{{ t('payment.comingSoon') }}</h2>
          <p>{{ t('payment.description') }}</p>
          <div class="total">
            <strong>{{ t('cart.subtotal') }}</strong>
            <strong>{{ money(subtotal) }}</strong>
          </div>
          <button class="primary" @click="navigate('cart')">
            {{ t('payment.back') }}
          </button>
        </div>
      </section>

      <!-- ABOUT -->
      <section
        v-else-if="page === 'about'"
        class="section page-section narrow"
      >
        <h1>{{ t('about.title') }}</h1>
        <p>{{ t('about.p1') }}</p>
        <p>{{ t('about.p2') }}</p>
        <p>{{ t('about.p3') }}</p>
      </section>

      <!-- WHOLESALE -->
      <section
        v-else-if="page === 'wholesale'"
        class="section page-section narrow"
      >
        <h1>{{ t('wholesale.title') }}</h1>
        <p>{{ t('wholesale.description') }}</p>
        <p>{{ t('wholesale.development') }}</p>
        <button class="primary" @click="navigate('contact')">
          {{ t('wholesale.contact') }}
        </button>
      </section>

      <!-- CONTACT -->
      <section
        v-else-if="page === 'contact'"
        class="section page-section narrow"
      >
        <h1>{{ t('contact.title') }}</h1>
        <p>{{ t('contact.description') }}</p>

        <div class="contact-card">
          <h2>{{ t('contact.sendMessage') }}</h2>
          <form class="checkout-form" @submit.prevent="submitContact">
            <label>
              {{ t('contact.name') }}
              <input v-model="contact.name" required>
            </label>
            <label>
              {{ t('contact.email') }}
              <input v-model="contact.email" type="email" required>
            </label>
            <label>
              {{ t('contact.subject') }}
              <select v-model="contact.subject">
                <option value="productInquiry">
                  {{ t('contact.productInquiry') }}
                </option>
                <option value="wholesaleOrder">
                  {{ t('contact.wholesaleOrder') }}
                </option>
                <option value="shipping">
                  {{ t('contact.shipping') }}
                </option>
                <option value="partnership">
                  {{ t('contact.partnership') }}
                </option>
                <option value="other">
                  {{ t('contact.other') }}
                </option>
              </select>
            </label>
            <label>
              {{ t('contact.message') }}
              <textarea v-model="contact.message" rows="5" required></textarea>
            </label>
            <button class="primary" type="submit">
              {{ t('contact.send') }}
            </button>
            <p v-if="contactNotice" class="notice" role="status">
              {{ t('contact.preview') }}
            </p>
          </form>
          <p class="note">{{ t('contact.preview') }}</p>
        </div>

        <div class="contact-card">
          <button class="whatsapp-button" @click="openWhatsApp">
            {{ t('whatsapp.join') }}
          </button>
        </div>
      </section>

      <!-- WHATSAPP -->
      <section
        v-else-if="page === 'whatsapp'"
        class="section page-section narrow"
      >
        <h1>{{ t('whatsapp.title') }}</h1>
        <div class="whatsapp-card">
          <div class="whatsapp-icon">💬</div>
          <p>{{ t('whatsapp.description') }}</p>
          <button class="whatsapp-button" @click="openWhatsApp">
            {{ t('whatsapp.join') }}
          </button>
          <p class="note">{{ t('whatsapp.privacy') }}</p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div>
        <strong>🍯 {{ t('brand.name') }}</strong>
        <p>{{ t('footer.slogan') }}</p>
        <p>{{ t('brand.by') }}</p>
        <p>{{ website }}</p>
      </div>
      <div class="footer-links">
        <button @click="navigate('contact')">{{ t('nav.contact') }}</button>
        <button @click="navigate('whatsapp')">{{ t('nav.whatsapp') }}</button>
        <button @click="navigate('wholesale')">{{ t('nav.wholesale') }}</button>
      </div>
      <div>
        <p>{{ t('footer.development') }}</p>
        <small>© {{ new Date().getFullYear() }} {{ t('brand.name') }}</small>
      </div>
    </footer>
  </div>
</template>

<style>
